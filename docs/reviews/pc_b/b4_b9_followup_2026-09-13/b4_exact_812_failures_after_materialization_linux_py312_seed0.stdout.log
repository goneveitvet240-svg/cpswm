        )
    
        selection = StructureTwoSelectedMethod.load(CONFIG)
        assert selection.content_sha256 == SELECTED_METHOD_RECEIPT_CONTENT_SHA256
        assert selection.content_sha256 == BACKBONE_CONTENT_SHA256
