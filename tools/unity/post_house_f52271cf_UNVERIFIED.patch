diff --git a/unity/Assets/Scripts/CpswmPostHouseLifecycle.cs b/unity/Assets/Scripts/CpswmPostHouseLifecycle.cs
new file mode 100644
index 00000000..27e08e4f
--- /dev/null
+++ b/unity/Assets/Scripts/CpswmPostHouseLifecycle.cs
@@ -0,0 +1,190 @@
+// Development backend: physical robot agents, NOT human-role observations.
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using UnityEngine;
+using UnityStandardAssets.Characters.FirstPerson;
+
+public sealed class CpswmPostHouseLifecycle : MonoBehaviour {
+    private AgentManager manager;
+    private readonly string generation = Guid.NewGuid().ToString("N");
+    private JObject initialization;
+    private BaseFPSAgentController initializedPrimary;
+    private bool initializationSucceeded;
+    private bool houseAttempted;
+    private bool houseReady;
+    private bool spawning;
+    private string committedRequest;
+    private int committedCount;
+    public bool Poisoned { get; private set; }
+
+    public static CpswmPostHouseLifecycle For(AgentManager manager) {
+        var state = manager.GetComponent<CpswmPostHouseLifecycle>();
+        if (state == null) state = manager.gameObject.AddComponent<CpswmPostHouseLifecycle>();
+        state.manager = manager;
+        return state;
+    }
+
+    public void ObservePreviousOutcome() {
+        if (initializedPrimary != null && manager.primaryAgent == initializedPrimary
+            && initializedPrimary.lastAction == "Initialize" && !initializedPrimary.IsProcessing) {
+            initializationSucceeded = initializedPrimary.lastActionSuccess;
+        }
+    }
+
+    public string ValidateInitialize(ServerAction action) {
+        if (manager.GetActiveAgentId() != 0) return "Only primary agent 0 may initialize.";
+        var count = action.dynamicServerAction.jObject["agentCount"];
+        if (count != null && count.Type != JTokenType.Integer) return "agentCount must be an integer.";
+        if (action.agentCount < 1 || action.agentCount > 6) return "agentCount must be 1..6.";
+        if (houseAttempted || manager.agents.Count > 1) return "Reset before reinitializing an existing house or roster.";
+        if (UnityEngine.SceneManagement.SceneManager.GetActiveScene().name.StartsWith("Procedural")
+            && action.agentCount > 1) {
+            return "Procedural initialization requires agentCount=1; create the house, teleport, then use CpswmSpawnAgents.";
+        }
+        return null;
+    }
+
+    public void RememberInitialize(ServerAction action) {
+        initialization = (JObject)action.dynamicServerAction.jObject.DeepClone();
+        initializedPrimary = manager.primaryAgent;
+        initializationSucceeded = false;
+    }
+
+    public string BeginHouse(BaseFPSAgentController caller) {
+        if (caller != manager.primaryAgent || manager.agents.Count != 1) return "Only the sole primary may create a house.";
+        if (Poisoned || houseAttempted || !initializationSucceeded) return "Fresh successful initialization is required; otherwise Reset.";
+        houseAttempted = true;
+        houseReady = false;
+        return null;
+    }
+
+    public void CompleteHouse(bool success) {
+        houseReady = success;
+        // CreateHouse may have partially changed physical state. Never advertise rollback.
+        if (!success) Poisoned = true;
+    }
+
+    public object Context() {
+        return new { generation, houseReady, spawning, poisoned = Poisoned,
+            agentCount = manager.agents.Count, robotAgentsOnly = true };
+    }
+
+    private static bool Finite(float value) { return !float.IsNaN(value) && !float.IsInfinity(value); }
+    private static bool Finite(Vector3 value) { return Finite(value.x) && Finite(value.y) && Finite(value.z); }
+
+    public void Spawn(BaseFPSAgentController caller, JObject request) {
+        string error = null;
+        var allowed = new HashSet<string>(DynamicServerAction.AllowedExtraneousParameters) {
+            "agentCount", "generation", "requestId"
+        };
+        if (request.Properties().Any(p => !allowed.Contains(p.Name))) error = "Unknown spawn parameter.";
+        if (caller != manager.primaryAgent || manager.GetActiveAgentId() != 0) error = "Only primary agent 0 may spawn.";
+        if (!houseReady || Poisoned || initialization == null || spawning) error = "House is not ready or episode is unusable.";
+        if (request["generation"] == null || request["generation"].Type != JTokenType.String
+            || (string)request["generation"] != generation) error = "Stale or invalid house generation.";
+        var idToken = request["requestId"];
+        if (idToken == null || idToken.Type != JTokenType.String || String.IsNullOrWhiteSpace((string)idToken)
+            || ((string)idToken).Length > 128) error = "A nonempty requestId of at most 128 characters is required.";
+        var countToken = request["agentCount"];
+        int count = 0;
+        if (countToken == null || countToken.Type != JTokenType.Integer
+            || !Int32.TryParse(countToken.ToString(), out count) || count < 1 || count > 6) error = "agentCount must be an integer in 1..6.";
+        if (error != null) { caller.actionFinished(false, errorMessage: error); return; }
+        string requestId = (string)idToken;
+        if (committedRequest != null) {
+            bool exact = committedRequest == requestId && committedCount == count && manager.agents.Count == count;
+            caller.actionFinished(exact, actionReturn: exact ? Context() : null,
+                errorMessage: exact ? null : "Roster already committed; Reset before changing the spawn request.");
+            return;
+        }
+        if (manager.agents.Count != 1 || manager.agentMode != "default" || caller.ItemInHand != null
+            || caller.gameObject.GetComponentsInChildren<SimObjPhysics>(true).Length != 0) {
+            caller.actionFinished(false, errorMessage: "Spawn requires one empty-handed default robot agent."); return;
+        }
+        List<Vector3> positions;
+        try {
+            var origin = caller.transform.position;
+            float clearance = 2f * caller.m_CharacterController.radius + 0.05f;
+            positions = new List<Vector3> { origin };
+            if (!Finite(origin)) throw new InvalidOperationException("Primary pose is nonfinite.");
+            Physics.SyncTransforms();
+            foreach (var candidate in caller.getReachablePositions(2f)
+                .OrderBy(p => (p - origin).sqrMagnitude).ThenBy(p => p.x).ThenBy(p => p.z)) {
+                if (positions.Count == count) break;
+                if (Finite(candidate) && Math.Abs(candidate.y - origin.y) < 0.05f
+                    && positions.All(p => Vector3.Distance(p, candidate) >= clearance)) positions.Add(candidate);
+            }
+            if (positions.Count != count) throw new InvalidOperationException("Insufficient distinct reachable spawn positions.");
+        } catch (Exception failure) {
+            caller.actionFinished(false, errorMessage: failure.Message); return;
+        }
+        spawning = true;
+        StartCoroutine(SpawnTransaction(caller, positions, requestId));
+    }
+
+    private IEnumerator SpawnTransaction(BaseFPSAgentController caller, List<Vector3> positions, string requestId) {
+        var staged = new List<BaseFPSAgentController>();
+        var components = new List<BaseAgentComponent>();
+        string failure = null;
+        for (int i = 1; i < positions.Count; i++) {
+            BaseFPSAgentController child = null;
+            try {
+                var component = UnityEngine.Object.Instantiate(caller.baseAgentComponent);
+                components.Add(component);
+                component.transform.position = positions[i];
+                child = (BaseFPSAgentController)Activator.CreateInstance(caller.GetType(), new object[] { component, manager });
+                staged.Add(child);
+                child.actionDuration = manager.actionDuration;
+                child.IsVisible = true;
+                child.m_Camera.depth = 1;
+                var init = (JObject)initialization.DeepClone();
+                init["action"] = "Initialize";
+                init["agentCount"] = 1;
+                init["agentId"] = i;
+                init["makeAgentsVisible"] = true;
+                child.ProcessControlCommand(new DynamicServerAction(init));
+                Physics.SyncTransforms();
+            } catch (Exception error) { failure = "Child construction failed: " + error.Message; }
+            if (failure != null) break;
+            int frames = 0;
+            while (child.IsProcessing && frames++ < 300) yield return null;
+            if (child.IsProcessing || !child.lastActionSuccess || !Finite(child.transform.position)
+                || Vector3.Distance(child.transform.position, positions[i]) > 0.06f) {
+                failure = "Child initialization timed out, failed, or displaced its spawn pose."; break;
+            }
+        }
+        if (failure == null) {
+            float clearance = 2f * caller.m_CharacterController.radius + 0.025f;
+            var actual = new List<Vector3> { caller.transform.position };
+            foreach (var child in staged) {
+                if (actual.Any(p => Vector3.Distance(p, child.transform.position) < clearance)) {
+                    failure = "Initialized agent bodies overlap."; break;
+                }
+                actual.Add(child.transform.position);
+            }
+        }
+        if (failure != null) {
+            foreach (var component in components) {
+                component.StopAllCoroutines();
+                component.gameObject.SetActive(false);
+                UnityEngine.Object.Destroy(component.gameObject);
+            }
+            Poisoned = true;
+            spawning = false;
+            caller.actionFinished(false, errorMessage: failure + " Episode discarded; Reset required.");
+            yield break;
+        }
+        // No response can emit while the primary caller is Processing. Publish only the complete set.
+        manager.agents.AddRange(staged);
+        caller.IsVisible = true;
+        caller.m_Camera.depth = 9999;
+        committedRequest = requestId;
+        committedCount = positions.Count;
+        spawning = false;
+        Physics.SyncTransforms();
+        caller.actionFinished(true, actionReturn: Context());
+    }
+}
